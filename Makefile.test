# Makefile for Docker-based testing of PostgreSQL cost_guard extension

# Docker image and container names
IMAGE_NAME = cost_guard_test
CONTAINER_NAME = cost_guard_test_container

# Default target
.PHONY: all
all: test

# Build the Docker test image
.PHONY: build
build:
	@echo "Building Docker test image..."
	docker build -f Dockerfile.test -t $(IMAGE_NAME) .

# Run tests using Docker Compose
.PHONY: test
test: build
	@echo "Starting PostgreSQL Cost Guard Extension test suite..."
	@echo "This will build, install, and test the extension in a clean PostgreSQL container."
	@echo ""
	@if docker run --rm --name $(CONTAINER_NAME) $(IMAGE_NAME); then \
		echo ""; \
		echo "✅ ALL TESTS COMPLETED SUCCESSFULLY!"; \
		echo "The cost_guard extension is working correctly."; \
	else \
		echo ""; \
		echo "❌ TESTS FAILED!"; \
		echo "Check the output above for error details."; \
		echo "Run 'make debug' for interactive debugging."; \
		exit 1; \
	fi

# Run specific tests by name (e.g., make test-only TESTS="test1,test3,test5")
test-only: build
	@echo "Running specific tests: $(TESTS)"
	@if [ -z "$(TESTS)" ]; then \
		echo "❌ ERROR: Please specify TESTS parameter"; \
		echo "Example: make test-only TESTS=\"test1,test3,test5\""; \
		exit 1; \
	fi
	@if docker run --rm --name $(CONTAINER_NAME) $(IMAGE_NAME) "$(TESTS)"; then \
		echo ""; \
		echo "✅ SELECTED TESTS COMPLETED SUCCESSFULLY!"; \
	else \
		echo ""; \
		echo "❌ SELECTED TESTS FAILED!"; \
		echo "Run 'make debug' for interactive debugging."; \
		exit 1; \
	fi

# Quick test shortcuts for individual tests
test1: build
	@$(MAKE) test-only TESTS="test1"

test2: build
	@$(MAKE) test-only TESTS="test2"

test3: build
	@$(MAKE) test-only TESTS="test3"

test4: build
	@$(MAKE) test-only TESTS="test4"

test5: build
	@$(MAKE) test-only TESTS="test5"

test6: build
	@$(MAKE) test-only TESTS="test6"

test7: build
	@$(MAKE) test-only TESTS="test7"

test8: build
	@$(MAKE) test-only TESTS="test8"

test9: build
	@$(MAKE) test-only TESTS="test9"

test10: build
	@$(MAKE) test-only TESTS="test10"

test11: build
	@$(MAKE) test-only TESTS="test11"

test12: build
	@$(MAKE) test-only TESTS="test12"

# Run tests using plain Docker (alternative method)
.PHONY: test-docker
test-docker: build
	@echo "Running tests in Docker container..."
	docker run --rm --name $(CONTAINER_NAME) $(IMAGE_NAME)

# Clean up Docker resources
.PHONY: clean
clean:
	@echo "Cleaning up Docker resources..."
	-docker-compose -f docker-compose.test.yml down -v
	-docker container rm -f $(CONTAINER_NAME) 2>/dev/null || true
	-docker image rm -f $(IMAGE_NAME) 2>/dev/null || true
	-docker volume prune -f
	@echo "Cleanup complete."

# Build and run tests with verbose output
.PHONY: test-verbose
test-verbose: build
	@echo "Running tests with verbose output..."
	docker run --rm --name $(CONTAINER_NAME) $(IMAGE_NAME) 2>&1 | tee test_output.log

# Interactive shell in test container for debugging
.PHONY: debug
debug: build
	@echo "Starting interactive shell in test container..."
	docker run --rm -it --name $(CONTAINER_NAME) --entrypoint /bin/bash $(IMAGE_NAME)

# Show Docker logs from last test run
.PHONY: logs
logs:
	@echo "Showing logs from last test run..."
	docker-compose -f docker-compose.test.yml logs

# Help target
.PHONY: help
help:
	@echo "PostgreSQL Cost Guard Extension - Docker Test Suite"
	@echo ""
	@echo "Available targets:"
	@echo "  build      - Build the Docker test image"
	@echo "  test       - Run the complete test suite (all 12 tests)"
	@echo "  test-only  - Run specific tests (requires TESTS parameter)"
	@echo "  test1-12   - Run individual tests by number"
	@echo "  clean      - Clean up Docker containers and images"
	@echo "  debug      - Run container interactively for debugging"
	@echo "  logs       - Show logs from the last test run"
	@echo "  shell      - Open a shell in the test container"
	@echo "  help       - Show this help message"
	@echo ""
	@echo "Examples:"
	@echo "  make test                              # Run all tests"
	@echo "  make test5                             # Run only test 5 (high cost query)"
	@echo "  make test-only TESTS=\"test1,test3,test5\" # Run specific tests"
	@echo "  make test-only TESTS=\"test1-5\"          # Run tests 1 through 5"
	@echo ""
	@echo "Test descriptions:"
	@echo "  test1  - Extension installation"
	@echo "  test2  - Default configuration"
	@echo "  test3  - Configuration changes"
	@echo "  test4  - Low cost query (should pass)"
	@echo "  test5  - High cost query (should fail) - Enhanced"
	@echo "  test6  - Extension disabled"
	@echo "  test7  - Utility statements"
	@echo "  test8  - Query cost analysis"
	@echo "  test9  - Warning system"
	@echo "  test10 - Boundary testing"
	@echo "  test11 - Extension uninstall"
	@echo "  test12 - Extension reinstall"
